# ============================================================================
# NAVIER - environment configuration
# Copy this file to `.env` and fill in the required values. `.env` is gitignored.
# ============================================================================

# --- Gemini co-pilot. Get a free key at https://aistudio.google.com ---
# Without a key the whole app still works; the co-pilot just stays dormant and the
# UI says so. CHAT model answers questions + explains P1/P2 alerts; TICKER model
# does the periodic proactive comments (it burns the bulk of the quota).
GEMINI_API_KEY=
GEMINI_MODEL_CHAT=gemini-3.1-flash-lite
GEMINI_MODEL_TICKER=gemini-3.1-flash-lite
ENABLE_COPILOT=1          # master switch for the co-pilot
COPILOT_PROACTIVE=0       # proactive ticker off by default; toggle it from the UI at runtime
COPILOT_MIN_INTERVAL_S=90 # cadence of the proactive ticker when enabled
COPILOT_DAILY_LIMIT=300   # courtesy daily cap, kept under the ~500/day flash-lite free tier

# --- Voice output: Windows system TTS. ---
# The backend synthesizes with the default Windows SAPI voice (System.Speech) and
# plays through the laptop speakers, so alerts and the co-pilot share one voice with
# priority (a P1 alert interrupts). Needs the `voice` extra (pip install -e ".[voice]")
# for playback. Without PowerShell or an audio device it stays silent; the text UI is
# unaffected.
ENABLE_TTS=1
# TTS_VOICE=                  # SAPI voice name; empty = an installed Italian voice, else default
# TTS_RATE=0                  # speaking rate, -10 (slow) to 10 (fast), 0 = normal
# TTS_OUTPUT_DEVICE=          # sounddevice index/name; empty = system default

# --- Voice input: push-to-talk speech-to-text. Available, idle until a key press. ---
# Press Space over the map: the backend beeps, records one phrase, transcribes it with
# Google STT (free, no key) and routes the text to the storm co-pilot, which answers by
# voice. ENABLE_STT makes it available (the mic button appears in the co-pilot panel).
# There is no wake word: capture starts only on request. Needs a mic and the `voice`
# extra. Set to 0 to hide it entirely.
ENABLE_STT=1
# STT_SILENCE_S=1.0           # end-of-phrase silence (SpeechRecognition pause_threshold)
# STT_LISTEN_TIMEOUT_S=5.0    # after the beep, wait this long for speech to start
# STT_RECORD_MAX_S=12.0       # hard cap on one phrase
# STT_BEEP_FREQ=880           # beep frequency in Hz played when capture starts
# STT_BEEP_MS=150             # beep duration in milliseconds

# --- Routing. No key needed: OSRM demo is used unless ORS_API_KEY is set. ---
ORS_API_KEY=
GOOGLE_MAPS_API_KEY=
# OSRM_BASE_URL=https://router.project-osrm.org
# ORS_BASE_URL=https://api.openrouteservice.org
# INTERCEPT_HORIZON_MIN=30   # project the target cell this far ahead when intercepting
# INTERCEPT_OFFSET_KM=8      # sidestep this far off the nucleus track

# --- Source feature flags (1 = on, 0 = off) ---
ENABLE_BLITZORTUNG=1
ENABLE_DPC_RADAR=1
ENABLE_DPC_PRODUCTS=1   # DPC POH + SRI, sampled for the hail + flash-flood rules
ENABLE_OPENMETEO=1
ENABLE_RAINVIEWER=1
ENABLE_PRETEMP=1       # convective outlooks in planning: PRETEMP map + ESTOFEX link
ENABLE_DPC_ALLERTE=1   # official DPC criticality bulletins → alert-zone choropleth + FLASH_FLOOD
ENABLE_GPSD=0
ENABLE_FAKE_LIGHTNING=0
# gpsd socket (only used when ENABLE_GPSD=1) - a USB GPS dongle read by gpsd.
# GPSD_HOST=127.0.0.1
# GPSD_PORT=2947

# --- Open-Meteo: convective environment ---
# CAPE/shear grid over Italy (ItaliaMeteo/ARPAE ICON-2I), no key. Feeds the cells'
# local CAPE (severity), the user-local CAPE+shear, and the planning heatmap
# (GET /api/planning). The free tier is metered per location, so the grid is coarse
# (~1°) and refetched hourly. Without it the app runs; CAPE-based bits stay dormant.
# OPENMETEO_MODEL=italia_meteo_arpae_icon_2i
# METEO_GRID_STEP_DEG=1.0    # ~1° lattice (~224 points over Italy); finer trips the 429 limit
# METEO_REFRESH_S=3600       # refetch the grid once an hour (the model runs hourly)

# --- Session recorder + replay ---
# Recording is MANUAL: press REC in the app to tape a session to data/sessions/<name>/
# (events.jsonl + radar frames), press again to stop and keep it. Nothing is written until
# requested - a chase is easily tens of MB of radar PNGs. Sessions: GET /api/sessions.
# To replay one, set REPLAY_FILE to its name/path and restart: the backend re-broadcasts it
# instead of going live (no ingestors).
ENABLE_RECORDER=1        # 0 hides the REC button entirely (no recording at all)
RECORDER_AUTOSTART=0     # 1 = tape every session from boot, as it used to
REPLAY_FILE=            # e.g. data/sessions/session_20260714_194600 (dir or its events.jsonl)
REPLAY_SPEED=1.0       # 2.0 = twice as fast

# --- Offline basemap ---
# Optional. If a PMTiles archive exists at this path, the backend serves it (with HTTP
# range support) and the map draws from it, so the base map, GPS and track keep working
# with no network - in a tunnel or a valley. Absent the file, the map uses online tiles.
# Drop a Protomaps vector extract of Italy (protomaps.com) or a raster archive here.
# BASEMAP_PMTILES=data/basemap.pmtiles

# --- Main thresholds (the rest live in config.py) ---
DBZ_CORE=45
MIN_AREA_KM2=20

# --- "Possible supercell" heuristic ---
# A cell is flagged only when ALL of these hold at once: it has lived long enough, with a
# sustained strong core, a high lightning rate, and a motion deviating from the 700-500 hPa
# mean flow. It is a heuristic, never a certainty - NAVIER has no Doppler radar, so no
# rotation is ever observed. Raise SUPERCELL_DEVIATION_DEG to 30 for a stricter flag.
SUPERCELL_MIN_LIFE_S=2700       # 45 min of life
SUPERCELL_DBZ_MIN=55            # sustained core (median over the window below)
SUPERCELL_DBZ_WINDOW_S=1200     # 20 min
SUPERCELL_LIGHTNING_MIN=15      # strikes/min
SUPERCELL_DEVIATION_DEG=25      # motion vs mean flow (+ = deviating right)

# --- Server ---
HOST=0.0.0.0
PORT=5700
# Comma-separated extra CORS origins for the Vite dev server / LAN companion.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
